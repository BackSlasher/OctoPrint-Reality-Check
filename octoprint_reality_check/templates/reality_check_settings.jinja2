<form class="form-horizontal">
    <h4>{{ _('Checks') }}</h4>
    <p class="help-block">
        {{ _('Every tool the print uses is checked, up to the extruder count in the printer profile (Settings > Printer Profiles > Hotend & extruder).') }}
    </p>
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: settings.plugins.reality_check.check_filament">
                {{ _('Check filament type (gcode vs M865)') }}
            </label>
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: settings.plugins.reality_check.check_nozzle">
                {{ _('Check nozzle size (gcode vs M862.1 Q)') }}
            </label>
        </div>
    </div>

    <h4>{{ _('Blocking') }}</h4>
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: settings.plugins.reality_check.warn_only">
                {{ _('Warn only') }}
            </label>
            <span class="help-block">
                {{ _('Show the problem but let the print run.') }}
            </span>
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: settings.plugins.reality_check.fail_closed">
                {{ _('Paranoid mode') }}
            </label>
            <span class="help-block">
                {{ _('Also block prints that cannot be fully verified: no answer from the printer, a stale reading after the printer was busy, nothing loaded, no metadata in the gcode, an unreadable file. By default these pass. Warn only still applies.') }}
            </span>
        </div>
    </div>

    <h4>{{ _('Notifications') }}</h4>
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: settings.plugins.reality_check.popup_on_pass">
                {{ _('Also show popups for passed/skipped checks') }}
            </label>
            <span class="help-block">
                {{ _('Blocked prints always pop up. Every result is always written to the log and to the Recent checks table in the Reality Check tab.') }}
            </span>
        </div>
    </div>

    <h4>{{ _('Polling') }}</h4>
    <div class="control-group">
        <label class="control-label">{{ _('Refresh interval') }}</label>
        <div class="controls">
            <div class="input-append">
                <input type="number" min="5" step="1" class="input-mini"
                       data-bind="value: settings.plugins.reality_check.refresh_interval">
                <span class="add-on">s</span>
            </div>
            <span class="help-block">
                {{ _('How often the printer is asked while idle. Polling pauses for about a minute after each print.') }}
            </span>
        </div>
    </div>
</form>
