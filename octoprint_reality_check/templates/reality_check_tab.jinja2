<div>
    <h4>{{ _('Printer inventory') }}</h4>
    <table class="table table-striped table-condensed">
        <thead>
        <tr>
            <th>{{ _('Tool') }}</th>
            <th>{{ _('Filament') }}</th>
            <th>{{ _('Nozzle') }}</th>
            <th>{{ _('Flags') }}</th>
        </tr>
        </thead>
        <tbody data-bind="foreach: tools">
        <tr>
            <td data-bind="text: tool"></td>
            <td data-bind="text: filament"></td>
            <td data-bind="text: nozzle"></td>
            <td data-bind="text: flags"></td>
        </tr>
        </tbody>
    </table>
    <p>
        {{ _('Cache age') }}: <span data-bind="text: age"></span>
        <button class="btn btn-mini" style="margin-left: 1em"
                data-bind="click: refresh, enable: !refreshing()">
            {{ _('Refresh from printer') }}
        </button>
    </p>
    <p>
        <a href="javascript:void(0)" data-bind="click: toggleEvents">
            <span data-bind="text: showEvents() ? '&#9662;' : '&#9656;'"></span>
            {{ _('Recent checks') }} (<span data-bind="text: events().length"></span>)
        </a>
    </p>
    <table class="table table-striped table-condensed" data-bind="visible: showEvents">
        <thead>
        <tr>
            <th style="width: 6em">{{ _('Time') }}</th>
            <th>{{ _('Report') }}</th>
        </tr>
        </thead>
        <tbody data-bind="foreach: events">
        <tr>
            <td data-bind="text: time"></td>
            <td data-bind="text: msg, css: {'text-error': level === 'error'}"></td>
        </tr>
        </tbody>
    </table>
    <p class="muted">
        {{ _('Polled from the firmware (M865 / M862.1 Q) while the printer idles; the pre-print gate compares the sliced gcode against this.') }}
    </p>
</div>
